{
  "manifest_version": 3,
  "name": "Vigie Marchés : sessions des plateformes",
  "short_name": "Vigie Marchés",
  "version": "1.0.0",
  "description": "Télécharge le DCE avec vos sessions déjà ouvertes sur PLACE, Maximilien, AWS-Achat, achatpublic… et garde ces sessions actives. Vos identifiants restent dans votre navigateur.",
  "permissions": ["storage", "alarms", "downloads"],
  "host_permissions": [
    "https://*.marches-publics.gouv.fr/*",
    "https://*.maximilien.fr/*",
    "https://*.e-megalisbretagne.org/*",
    "https://*.alsacemarchespublics.eu/*",
    "https://*.grandest.fr/*",
    "https://*.auvergnerhonealpes.eu/*",
    "https://*.hautsdefrance.fr/*",
    "https://*.nouvelle-aquitaine.fr/*",
    "https://*.ampmetropole.fr/*",
    "https://*.ternum-bfc.fr/*",
    "https://*.paysdelaloire.fr/*",
    "https://*.atexo.com/*",
    "https://*.local-trust.com/*",
    "https://*.marches-publics.info/*",
    "https://*.achatpublic.com/*",
    "https://*.e-marchespublics.com/*",
    "https://*.marches-securises.fr/*",
    "https://*.klekoon.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://vigie-marches.onrender.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "action": { "default_title": "Vigie Marchés : mes plateformes", "default_popup": "popup.html", "default_icon": { "16": "icone16.png", "48": "icone48.png", "128": "icone128.png" } },
  "icons": { "16": "icone16.png", "48": "icone48.png", "128": "icone128.png" }
}
